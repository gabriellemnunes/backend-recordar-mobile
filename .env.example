PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/recordar_mobile?replicaSet=rs0
JWT_SECRET=substitua-por-um-segredo-local-forte

# Segredo privado compartilhado apenas com o serviço de IA (mínimo 32 caracteres).
AI_SERVICE_TOKEN=

# IA local gratuita. O endereço fica somente no backend, nunca no APK.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
CHAT_TIMEOUT_MS=90000
# Opcional: 0 força CPU quando o driver de vídeo não responder bem.
# OLLAMA_NUM_GPU=0
# Opcional: AI_PROVIDER=openai (cobrança por uso)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Demonstração no Render: AI_PROVIDER=groq. Use apenas dados fictícios.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Producao: production. Em desenvolvimento, use development.
NODE_ENV=development
# Origens web separadas por virgula. No app React Native nativo, Origin e normalmente ausente.
CORS_ORIGINS=
# NUNCA habilitar em producao. Somente para a tela legada de demonstracao local.
ALLOW_INSECURE_PASSWORD_RECOVERY=false
