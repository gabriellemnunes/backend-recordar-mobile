PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/recordar_mobile?replicaSet=rs0
JWT_SECRET=substitua-por-um-segredo-local-forte

# Segredo privado compartilhado apenas com o serviço de IA (mínimo 32 caracteres).
AI_SERVICE_TOKEN=

# Producao: production. Em desenvolvimento, use development.
NODE_ENV=development
# Origens web separadas por virgula. No app React Native nativo, Origin e normalmente ausente.
CORS_ORIGINS=
# NUNCA habilitar em producao. Somente para a tela legada de demonstracao local.
ALLOW_INSECURE_PASSWORD_RECOVERY=false
